 * @description Common predicates for filtering types by context.
 */

import lib.files
import lib.traits
import rust

/** Holds if `t` is defined inside a function body rather than at module level. */
predicate isLocalType(TypeItem t) {
  exists(Function f |
    fileOf(f) = fileOf(t) and
    startLine(t) > startLine(f) and
    endLine(t) <= endLine(f)
  )
}

/** Holds if `t` was generated by a macro expansion. */
predicate isMacroGenerated(TypeItem t) {
  exists(MacroItems m | t = m.getItem(_))
  or
  // Serde's internal generated types (e.g. __FieldVisitor, __Visitor, __Field).
  t.getName().getText().matches("\\_\\_%")
}

/** Holds if `t` is inside a test module or test file. */
predicate isTestCode(TypeItem t) {
  fileOf(t).getAbsolutePath().matches("%/tests/%")
  or
  // #[cfg(test)] modules embedded in source files.
  exists(Module m |
    fileOf(t) = fileOf(m) and
    startLine(t) > startLine(m) and
    endLine(t) <= endLine(m) and
    m.getName().getText() = "tests" and
    m.getAnAttr().getMeta().getPath().getSegment().getIdentifier().getText() = "cfg"
  )
}

/** Holds if `t` holds secret or security-sensitive material. */
predicate isSecretType(TypeItem t) {
  t.getName().getText().regexpMatch(".*(Secret|Private|Seed|Password|Mnemonic|Share).*") and
  // Exclude types whose name contains "Shared" (e.g. SharedState),
  // which match the Share substring but are not secret holders.
  not t.getName().getText().regexpMatch(".*Shared.*")
}

/** Holds if `t` is a source type eligible for any check. */
predicate isSourceType(TypeItem t) {
  (t instanceof Struct or t instanceof Enum or t instanceof Union) and
  fileOf(t).fromSource() and
  not isTestCode(t) and
  not isMacroGenerated(t) and
  not isLocalType(t)
}
