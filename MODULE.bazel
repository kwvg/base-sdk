    "2026-02-01/llvm-tools-nightly-aarch64-unknown-linux-gnu.tar.xz": "bade74408206e182e3a3fc2eeb51ab8dae5adc4c173ff74a2e4ad68b01ec4759",
    "2026-02-01/rust-std-nightly-aarch64-unknown-linux-gnu.tar.xz": "36ba4b6f63a015423e314359bee97bb66193603b216984bc7b10a4da3809d619",
    "2026-02-01/rustc-nightly-aarch64-unknown-linux-gnu.tar.xz": "be688f082d82588cf92bf65e279c970f81ea75b13af7f3857a07a832bc6e50c9",
    "2026-02-01/cargo-nightly-x86_64-apple-darwin.tar.xz": "22a67c1ac511e3383114396f8671719ea14f2a96e9a2fec08443608534519dab",
    "2026-02-01/clippy-nightly-x86_64-apple-darwin.tar.xz": "0d2f28dcf9a55adf48681c0b03fce2897d5919b7ae2a262a6dbe4152ef9198ca",
    "2026-02-01/llvm-tools-nightly-x86_64-apple-darwin.tar.xz": "ec7eda16fa943104fcb4713560921da567dda1db8e5b2fbc4881b82ebf29c1e2",
    "2026-02-01/rust-std-nightly-x86_64-apple-darwin.tar.xz": "385ac0f16b24c0a1d4ba560b4e3138bcfc13e2bccb75e7af1055c709d11b8e6a",
    "2026-02-01/rustc-nightly-x86_64-apple-darwin.tar.xz": "d86a16e916c7e829e16c9b8b810f1436afd9e41e24e20be9e19c2c911282455c",
