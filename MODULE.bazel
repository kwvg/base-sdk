rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# An empty `versions` stops rules_rust registering its unhashed defaults.
# Nothing here needs rustfmt, rust-analyzer or the wasm targets.
rust.toolchain(
    extra_target_triples = [],
    versions = [],
)

# One set per supported host. `target_compatible_with` is required, or the
# toolchain claims every target. An empty `rustfmt_version` drops rustfmt.
rust.repository_set(
    name = "rust_macos_aarch64",
    edition = "2021",
    exec_triple = "aarch64-apple-darwin",
    rustfmt_version = "",
    sha256s = RUST_SHA256S,
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    target_triple = "aarch64-apple-darwin",
    versions = [RUST_NIGHTLY],
)
rust.repository_set(
    name = "rust_macos_x86_64",
    edition = "2021",
    exec_triple = "x86_64-apple-darwin",
    rustfmt_version = "",
    sha256s = RUST_SHA256S,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
    target_triple = "x86_64-apple-darwin",
    versions = [RUST_NIGHTLY],
)
rust.repository_set(
    name = "rust_linux_aarch64",
    edition = "2021",
    exec_triple = "aarch64-unknown-linux-gnu",
    rustfmt_version = "",
    sha256s = RUST_SHA256S,
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    target_triple = "aarch64-unknown-linux-gnu",
    versions = [RUST_NIGHTLY],
)
rust.repository_set(
    name = "rust_linux_x86_64",
    edition = "2021",
    exec_triple = "x86_64-unknown-linux-gnu",
    rustfmt_version = "",
    sha256s = RUST_SHA256S,
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    target_triple = "x86_64-unknown-linux-gnu",
    versions = [RUST_NIGHTLY],
)

# Apple targets every host can cross-compile to. Each needs its `rust-std`
# hashed in `RUST_SHA256S`.
APPLE_TARGET_TRIPLES = {
    "aarch64-apple-darwin": [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
    "x86_64-apple-darwin": [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
}

# Each host also gets every Apple triple other than its own. A follow-up tag
# may only add a target triple to an existing set.
[
    rust.repository_set(
        name = name,
        target_compatible_with = constraints,
        target_triple = triple,
    )
    for name, host_triple in {
        "rust_linux_aarch64": "aarch64-unknown-linux-gnu",
        "rust_linux_x86_64": "x86_64-unknown-linux-gnu",
        "rust_macos_aarch64": "aarch64-apple-darwin",
        "rust_macos_x86_64": "x86_64-apple-darwin",
    }.items()
    for triple, constraints in APPLE_TARGET_TRIPLES.items()
    if triple != host_triple
]

use_repo(
    rust,
    "rust_linux_aarch64__aarch64-apple-darwin__nightly",
    "rust_linux_aarch64__aarch64-unknown-linux-gnu__nightly",
    "rust_linux_aarch64__x86_64-apple-darwin__nightly",
    "rust_linux_x86_64__aarch64-apple-darwin__nightly",
    "rust_linux_x86_64__x86_64-apple-darwin__nightly",
    "rust_linux_x86_64__x86_64-unknown-linux-gnu__nightly",
    "rust_macos_aarch64__aarch64-apple-darwin__nightly",
    "rust_macos_aarch64__x86_64-apple-darwin__nightly",
    "rust_macos_x86_64__aarch64-apple-darwin__nightly",
    "rust_macos_x86_64__x86_64-apple-darwin__nightly",
)

register_toolchains(
    "@rust_linux_aarch64__aarch64-apple-darwin__nightly//:toolchain",
    "@rust_linux_aarch64__aarch64-unknown-linux-gnu__nightly//:toolchain",
    "@rust_linux_aarch64__x86_64-apple-darwin__nightly//:toolchain",
    "@rust_linux_x86_64__aarch64-apple-darwin__nightly//:toolchain",
    "@rust_linux_x86_64__x86_64-apple-darwin__nightly//:toolchain",
    "@rust_linux_x86_64__x86_64-unknown-linux-gnu__nightly//:toolchain",
    "@rust_macos_aarch64__aarch64-apple-darwin__nightly//:toolchain",
    "@rust_macos_aarch64__x86_64-apple-darwin__nightly//:toolchain",
    "@rust_macos_x86_64__aarch64-apple-darwin__nightly//:toolchain",
    "@rust_macos_x86_64__x86_64-apple-darwin__nightly//:toolchain",
)

# Triples the crate graph renders `select()` arms for; an unlisted triple is
# incompatible. The NixOS pair serves a `--host_platform` of NixOS.
CRATE_PLATFORM_TRIPLES = [
    "aarch64-unknown-linux-gnu",
    "aarch64-unknown-nixos-gnu",
    "x86_64-unknown-linux-gnu",
    "x86_64-unknown-nixos-gnu",
] + sorted(APPLE_TARGET_TRIPLES.keys())

# `dash-meta-bazel` depends on every crate Bazel builds, so its manifest makes
# `crate_universe` resolve the whole third-party graph.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//contrib/meta/bazel:Cargo.toml",
        "//pkgs/pow:Cargo.toml",
    ],
    # Cargo owns `Cargo.lock`; Bazel only reads it.
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = CRATE_PLATFORM_TRIPLES,
)
use_repo(crate, "crates")
