# Bazel module for `just zbld`. Bazel 9 is bzlmod only; there is no WORKSPACE.

module(
    name = "dash_sdk",
    version = "0.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.73.0")

# Mirrors `rust-toolchain.toml`. `.bazelrc` must also select the channel.
RUST_NIGHTLY = "nightly/2026-02-01"

# Digests from the `.sha256` sidecars at static.rust-lang.org/dist. A key
# missing here makes the fetch skip its integrity check, so every artifact
# the toolchains below fetch must be listed.
