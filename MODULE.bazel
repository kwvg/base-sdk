    "2026-02-01/cargo-nightly-aarch64-apple-darwin.tar.xz": "d44376a1e54a97b244b69483604602c0cece2b3a09ebd5a7499182f7ee0c23cb",
    "2026-02-01/clippy-nightly-aarch64-apple-darwin.tar.xz": "1e32a5a31623b9fbf4eae896dd4ef009832d651f01a202fce64fa8ca668bfaf4",
    "2026-02-01/llvm-tools-nightly-aarch64-apple-darwin.tar.xz": "45d9b7f97a085f112555508d732f6f5fc309c3d42e54520b08790b99c5b2ff8e",
    "2026-02-01/rust-std-nightly-aarch64-apple-darwin.tar.xz": "b4273f0f9f2716c6fda95ff3a64237b0b02733de1fc870aebcaadd0cfeeb1479",
