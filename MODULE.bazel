    "2026-02-01/llvm-tools-nightly-x86_64-unknown-linux-gnu.tar.xz": "d3e361aae313666e174968fa11935b2ca06762ec66f676d5df0cc0bcfea1488a",
    "2026-02-01/rust-std-nightly-x86_64-unknown-linux-gnu.tar.xz": "c5c0ce572e9b6cd9956308cc3f8d5beedfe10ae87e5e965cbe21007cb03e98dd",
    "2026-02-01/rustc-nightly-x86_64-unknown-linux-gnu.tar.xz": "72f3d9ac47710773931732204e8841240e348c8e63771d0360ddef11afe350ed",
