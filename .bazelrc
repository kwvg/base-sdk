# Mirrors `rust-toolchain.toml`; rules_rust needs it to resolve a nightly.
build --@rules_rust//rust/toolchain/channel=nightly

# Lets a build say `--build_profile=release`.
common --flag_alias=build_profile=//:build_profile

# Fat LTO needs bitcode in every rlib, and rules_rust asks for none. The flag
# is single-valued, so a later setting must repeat this one.
build --@rules_rust//rust/settings:extra_rustc_flags=-Cembed-bitcode=yes

# The repo contents cache cannot live in the repository, where the justfiles
# put Bazel's output root.
common --repo_contents_cache=

# Selected by CI, so a stale lock fails rather than being rewritten.
common:ci --lockfile_mode=error

# A build script that fetched would make every pin advisory.
build --nosandbox_default_allow_network

# Reusing sandbox directories skips most input staging, which is slow on HFS+.
build --reuse_sandbox_directories

build --verbose_failures

try-import %workspace%/.bazelrc.user
