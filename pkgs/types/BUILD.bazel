load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:defs.bzl", "PROFILE_RUSTC_FLAGS", "RUSTC_LINTS")

package(default_visibility = ["//visibility:public"])

# Read by `crate_universe`.
exports_files(["Cargo.toml"])

# Third-party dependencies come from the manifest. Workspace ones and
# `crate_features` restate it, so keep them equal.
rust_library(
    name = "dash-types",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "bitcoin-primitives",
        "codec",
        "default",
        "full",
        "serde",
        "std",
    ],
    crate_name = "dash_types",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True) + ["//pkgs/types/marker:dash-types-marker"],
    rustc_flags = RUSTC_LINTS + PROFILE_RUSTC_FLAGS,
    deps = all_crate_deps(normal = True),
)
